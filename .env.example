# Telegram Bot API Configuration (Server-side only for security)
# 1. Create a bot in Telegram via @BotFather to get your TELEGRAM_BOT_TOKEN
# 2. Get your personal/admin chat ID via @userinfobot or channel ID
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_ADMIN_CHAT_ID="YOUR_ADMIN_CHAT_ID"

# Notification Destination Email
# Email address where incoming incubator applications will be delivered
NOTIFY_EMAIL="hello@vuonqn.site"

